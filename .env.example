# Salin file ini menjadi .env.local untuk development, atau .env.production untuk production.
# Jangan commit file .env.local / .env.production yang berisi nilai asli.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL + PostGIS)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=datin
DB_USER=jambari
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery & Cache)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# HTTPS redirect (matikan untuk development lokal)
SECURE_SSL_REDIRECT=False

# Berita: komentar Facebook & URL publik (untuk tombol bagikan/OG)
# FACEBOOK_APP_ID opsional — isi App ID dari developers.facebook.com
# agar komentar bisa dimoderasi lewat Facebook.
SITE_URL=https://stageof-jayapura.bmkg.go.id
FACEBOOK_APP_ID=
